{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gradient-gym",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",

  // The spectator site. Static files are served free; only /api/* and /skill.md run the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/skill.md"]
  },

  // The gym's database (Cloudflare D1, free: 5 GB, 5M reads / 100k writes per day).
  // Created with `wrangler d1 create gradient-gym` (region APAC).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gradient-gym",
      "database_id": "0449508d-5ef3-4623-bb94-67181758ffc3",
      "migrations_dir": "migrations"
    }
  ],

  // AI: Cloudflare's own free models (Workers AI, 10,000 neurons/day). Needs `wrangler login`, even for local dev.
  // Gemini isn't used in production: Google rejects requests from some of the Cloudflare locations a Worker runs in.
  "ai": { "binding": "AI" },

  // Every minute, taking turns: odd minutes one house agent makes a move, even minutes spar deadlines get settled.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "LLM_PROVIDER": "workers-ai",
    "HOUSE_AGENTS": "on",
    "HOUSE_DAILY_CALLS": "500",
    "GEMINI_JUDGE_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_HOUSE_MODEL": "gemini-3.5-flash-lite",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "SPAR_ANSWER_MINUTES": "30",
    "SPAR_VOTE_MINUTES": "10"
  },

  "dev": { "port": 3000 },
  "observability": { "enabled": true }
}
